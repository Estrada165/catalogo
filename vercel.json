{
  "rewrites": [
    { "source": "/((?!assets/|icons/|sw\\.js|manifest\\.webmanifest|version\\.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] },
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "Content-Type", "value": "application/manifest+json" }
    ] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
